# THERESE — environment variables (copy to .env and adjust)
# Setup:  python create_env_template.py   (creates .env only if missing)
#         or:  copy .env.example .env      (Windows)

# --- Django core ---
DEBUG=True
SECRET_KEY=change-me-generate-your-own

# Comma-separated hostnames/IPs (no spaces). Wildcards like 172.26.70.* work in base.py.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave DB_HOST empty for SQLite (local development).
# Set DB_HOST for MariaDB/MySQL (production).
DB_HOST=
DB_NAME=therese
DB_USER=therese
DB_PASSWORD=
DB_PORT=3306

# --- HTTPS / Gunicorn (start_therese_prod.sh) ---
# Institute certificates on the server, or leave empty for self-signed certs/ in certs/
CERT_FILE=
KEY_FILE=

# --- Outbound email (SMTP) ---
# Never commit real passwords. Copy this file to .env (gitignored) and fill in secrets.
# Strato mailboxes: smtp.strato.de, port 465, SSL/TLS, username = full address.
# Leave EMAIL_HOST empty to use Django's console backend (prints mail to the log).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Public site origin used in account emails (no trailing slash), e.g. https://therese.example.org
SITE_URL=
# Random pause in seconds between bulk password-reset emails (protects the SMTP host).
ACCOUNT_EMAIL_PAUSE_MIN=5
ACCOUNT_EMAIL_PAUSE_MAX=15